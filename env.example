<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Spotify Monthly Listener History</title>
  <link rel="stylesheet" href="/styles.css?v=4.1.0">
</head>
<body>
  <header>
    <h1>Spotify Monthly Listener History</h1>
    <p>アーティストの月間リスナー推移を検索</p>
  </header>

  <main>
    <section class="search-card">
      <input id="search" placeholder="アーティスト名">
      <button id="searchButton">検索</button>
    </section>

    <section>
      <div id="status"></div>
      <div id="artists" class="grid"></div>
    </section>

    <section id="detail" class="detail hidden">
      <button id="closeDetail">閉じる</button>
      <h2 id="artistName"></h2>
      <p id="artistLatest"></p>
      <canvas id="chart" width="1000" height="420"></canvas>
    </section>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.8/dist/chart.umd.min.js"></script>
  <script src="/app.js?v=4.1.0"></script>
</body>
</html>
