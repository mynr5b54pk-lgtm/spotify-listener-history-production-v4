NODE_ENV=production
PORT=3000
APP_BASE_URL=http://localhost:3000

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_REPLACE_ME

HEADLESS=true
LOG_LEVEL=info

# 本番の日次上限
MAX_ARTIST_UPDATES_PER_DAY=10000
MAX_PLAYLIST_SCANS_PER_DAY=500
MAX_DISCOVERY_QUERIES_PER_DAY=100

# 1回の起動上限（3時間ごと、1日8回）
MAX_ARTIST_UPDATES_PER_RUN=1300
MAX_PLAYLIST_SCANS_PER_RUN=65
MAX_DISCOVERY_QUERIES_PER_RUN=13

# Playwright・安定性
BROWSER_CONCURRENCY=3
REQUEST_DELAY_MS=2200
REQUEST_JITTER_MS=1200
PAGE_TIMEOUT_MS=45000
PAGE_SETTLE_MS=4500
MAX_RETRIES=3
RETRY_BASE_DELAY_MS=5000
MAX_RUNTIME_MINUTES=325

# 更新ルール
MIN_MONTHLY_LISTENERS=10000
ACTIVE_RECHECK_HOURS=24
BELOW_THRESHOLD_RECHECK_DAYS=30
PLAYLIST_RESCAN_DAYS=7
MAX_FAILURES_BEFORE_PAUSE=12

# ワーカー排他制御
WORKER_NAME=spotify-production-worker-v4
LOCK_TTL_MINUTES=340

# 公開API
PUBLIC_API_PAGE_SIZE=50
PUBLIC_API_MAX_PAGE_SIZE=100
PUBLIC_API_MAX_PAGE=1000
PUBLIC_API_MAX_QUERY_LENGTH=100
PUBLIC_API_RATE_LIMIT_WINDOW_MS=60000
PUBLIC_API_RATE_LIMIT_MAX_REQUESTS=120
ADMIN_API_RATE_LIMIT_MAX_REQUESTS=20

# 通常は1。リバースプロキシなしで直接公開する場合は0
TRUST_PROXY_HOPS=1

# カンマ区切り。空欄ならAPP_BASE_URLと同一オリジンのみ許可
CORS_ALLOWED_ORIGINS=

ADMIN_TOKEN=CHANGE_THIS_TO_AT_LEAST_32_RANDOM_CHARACTERS
