NODE_ENV=production
PORT=3000
APP_BASE_URL=http://localhost:3000

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_REPLACE_ME

HEADLESS=true
LOG_LEVEL=info

# 本番の日次安全上限
MAX_ARTIST_UPDATES_PER_DAY=50000
MAX_PLAYLIST_SCANS_PER_DAY=800
MAX_DISCOVERY_QUERIES_PER_DAY=160

# 1回の起動上限（本番は毎時キュー、同時実行はDBロックで防止）
MAX_ARTIST_UPDATES_PER_RUN=2500
MAX_PLAYLIST_SCANS_PER_RUN=6
MAX_DISCOVERY_QUERIES_PER_RUN=2
MAX_CANDIDATE_UPDATES_PER_RUN=150
ARTIST_COLLECTION_MODE=balanced
MAX_PLAYLIST_ACTIVE_POOL=2000

# Playwright・安定性
BROWSER_CONCURRENCY=10
REQUEST_DELAY_MS=2200
REQUEST_JITTER_MS=1200
PAGE_TIMEOUT_MS=45000
PAGE_SETTLE_MS=4500
MAX_RETRIES=3
RETRY_BASE_DELAY_MS=5000
MAX_RUNTIME_MINUTES=325
ANOMALY_RECHECK_RATIO=1.5
ANOMALY_CONFIRM_TOLERANCE_PERCENT=1

# 更新ルール
MIN_MONTHLY_LISTENERS=10000
ACTIVE_RECHECK_HOURS=120
PLAYLIST_RESCAN_DAYS=7

# ワーカー排他・監視
WORKER_NAME=spotify-production-worker-v4
LOCK_TTL_MINUTES=10
WORKER_STALE_HOURS=4
WORKER_RESTART_DELAY_MINUTES=15
WORKER_STALE_RUN_MINUTES=20
WORKER_HEARTBEAT_INTERVAL_MS=60000
WORKER_HEARTBEAT_STALE_MINUTES=15

# 公開API
PUBLIC_API_PAGE_SIZE=50
PUBLIC_API_MAX_PAGE_SIZE=100
PUBLIC_API_MAX_PAGE=10000
PUBLIC_API_MAX_QUERY_LENGTH=100
PUBLIC_API_RATE_LIMIT_WINDOW_MS=60000
PUBLIC_API_RATE_LIMIT_MAX_REQUESTS=120
ADMIN_API_RATE_LIMIT_MAX_REQUESTS=20

# 通常は1。リバースプロキシなしで直接公開する場合は0
TRUST_PROXY_HOPS=1

# カンマ区切り。空欄ならAPP_BASE_URLと同一オリジンのみ許可
CORS_ALLOWED_ORIGINS=

ADMIN_TOKEN=CHANGE_THIS_TO_AT_LEAST_32_RANDOM_CHARACTERS
